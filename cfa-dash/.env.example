DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=True

# Server session security (set FLASK_SECRET_KEY in production — long random string).
FLASK_SECRET_KEY=
SESSION_LIFETIME_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# SQLite POC database is created automatically at cfa-dash/data/zcams.db.

# CapitalPay integration. Use real when KEY/SECRET are set; mock otherwise.
CAPITALPAY_MODE=real
CAPITALPAY_BASE_URL=https://app.capitalpay.co.tz/api
CAPITALPAY_KEY=
CAPITALPAY_SECRET=
CAPITALPAY_ACCOUNT_ID=48
CAPITALPAY_PAYMENT_GATEWAY_ID=1
CAPITALPAY_PAY_URL_TEMPLATE=https://app.capitalpay.co.tz/pay/{invoice_number}
CAPITALPAY_CALLBACK_URL=
CAPITALPAY_NOTIFICATION_URL=
# Legacy aliases (optional)
CAPITALPAY_API_KEY=
CAPITALPAY_MERCHANT_ID=48
CAPITALPAY_WEBHOOK_SECRET=

# BL OCR integration. Supported values: mock, openai.
# Scanned PDFs and image uploads always use OpenAI vision OCR (OCR_IMAGE_PROVIDER).
# Set OPENAI_API_KEY=sk-... — do NOT set OCR_API_KEY=openai (placeholder breaks OCR).
OCR_PROVIDER=openai
OCR_IMAGE_PROVIDER=openai
OCR_API_KEY=
OCR_TEXT_PDF_TIMEOUT_SEC=5
OPENAI_OCR_DPI=200
OPENAI_OCR_MAX_PAGES=2
OPENAI_OCR_MAX_WIDTH=1800
OPENAI_OCR_JPEG_QUALITY=82
OPENAI_OCR_MAX_WORKERS=3
OPENAI_OCR_MODEL=gpt-5.4-mini
OPENAI_OCR_STORE=false
OPENAI_API_KEY=

# ZCAMS Chat — OpenAI router first, then FAQ/tutorials/local Qwen/direct OpenAI.
# Run once on the server: python scripts/download_chat_model.py
# CHAT_DEVICE_MAP=auto picks GPU when CUDA is available, otherwise CPU.
CHAT_MODEL_ENABLED=true
CHAT_MODEL_NAME=unsloth/Qwen2.5-0.5B-Instruct
CHAT_DEVICE_MAP=auto
CHAT_WARMUP=false
CHAT_WARMUP_DELAY_SEC=45
CHAT_OPENAI_TIMEOUT_SEC=3
CHAT_OPENAI_DIRECT_TIMEOUT_SEC=12
CHAT_QWEN_TIMEOUT_SEC=45
CHAT_QWEN_MAX_TOKENS=64
CHAT_ROUTER_MAX_TOKENS=40
# auto=OpenAI for general knowledge on CPU (recommended on EC2); openai=always; local_qwen=Qwen first
CHAT_GENERAL_VIA=auto
OPENAI_CHAT_MODEL=gpt-4o-mini
# Conversation audit log (relative to cfa-dash/ unless absolute).
CHAT_STATE_MD=data/chat_state.md

# Bird Reach email API (preferred for CFA credentials + invoice PDF attachments).
BIRD_EMAIL_MODE=mock
BIRD_EMAIL_API_URL=https://email.us-west-2.api.bird.com/api/workspaces/YOUR_WORKSPACE/reach/transmissions
BIRD_EMAIL_ACCESS_KEY=
BIRD_EMAIL_FROM=no_reply@zcams.info
BIRD_EMAIL_FROM_NAME=ZCAMS

# Gmail SMTP fallback (plain text only, no PDF attachments).
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
GMAIL_FROM_EMAIL=

# Public URL for invoice PDFs, contract signing links, and share messages.
# Local dev: http://127.0.0.1:8050   Production: https://zcams.info
PUBLIC_APP_URL=http://127.0.0.1:8050

# Progressive Web App (install to home screen on mobile/desktop).
PWA_ENABLED=true
PWA_START_URL=/login
PWA_THEME_COLOR=#0a4f20
PWA_BACKGROUND_COLOR=#062d13
PWA_ICON_PATH=/assets/zcams-logo.png
